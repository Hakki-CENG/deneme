HAF_HOST=0.0.0.0
HAF_PORT=8787
HAF_HOME=./var
# Optional local API bearer token. Required before exposing beyond loopback.
HAF_API_TOKEN=
# mock | openai-compatible | openai | openai-responses | openai-codex | azure-openai | aws-bedrock | anthropic | openrouter | google | vertex | groq | xai | deepseek | mistral | ollama
HAF_MODEL_PROVIDER=mock
HAF_MODEL_BASE_URL=https://api.openai.com/v1
HAF_MODEL_NAME=gpt-4.1-mini
# Used by native Azure OpenAI deployment routes when needed.
HAF_MODEL_API_VERSION=
# Used by AWS Bedrock and regional cloud providers.
HAF_MODEL_REGION=
HAF_MODEL_API_KEY=
# Optional same-provider pool: JSON array of strings or {"id":"...","apiKey":"..."} objects.
HAF_MODEL_API_KEYS_JSON=
# Explicit ordered provider:model fallback routes. No implicit cross-provider fallback occurs.
HAF_MODEL_FALLBACKS=
# Native ChatGPT Codex subscription mode requires HAF_MODEL_PROVIDER=openai-codex
# and an account-visible model selected after device login. No API key is used.
HAF_CODEX_REASONING_EFFORT=medium
HAF_CODEX_REQUEST_TIMEOUT_MS=180000

# Public callbacks registered with OAuth-enabled integrations.
HAF_MCP_OAUTH_REDIRECT_URI=https://haf.example.com/auth/mcp/callback
HAF_MODEL_OAUTH_REDIRECT_URI=https://haf.example.com/auth/model-oauth/callback

# Durable direct-family agent messaging
HAF_AGENT_MESSAGE_MAX_CHARS=16384
HAF_AGENT_MESSAGE_MAX_PENDING=20
HAF_AGENT_MESSAGE_RATE_CAPACITY=3
HAF_AGENT_MESSAGE_RATE_REFILL_MS=1000

# Model-facing context projection and deterministic rolling micro-compaction
HAF_CONTEXT_MAX_CHARS=80000
HAF_ROLLING_MICRO_COMPACTION=true
HAF_MICRO_COMPACTION_TAIL_CHARS=36000
HAF_MICRO_COMPACTION_WINDOW_MESSAGES=12
HAF_MICRO_COMPACTION_SUMMARY_CHARS=1200
HAF_MICRO_COMPACTION_CACHE_WINDOWS=500

# Optional external user-model memory provider. Local governed memory always remains active.
# Set HAF_MEMORY_PROVIDER=honcho and provide HONCHO_API_KEY for Honcho Cloud.
HAF_MEMORY_PROVIDER=
HONCHO_API_KEY=
HONCHO_URL=https://api.honcho.dev
HONCHO_WORKSPACE_ID=haf
HAF_HONCHO_USER_PEER=user
HAF_HONCHO_ASSISTANT_PEER=haf
HAF_HONCHO_RECALL_MODE=hybrid
HAF_HONCHO_CONTEXT_TOKENS=2000
HAF_HONCHO_CONTEXT_CADENCE=1
HAF_HONCHO_MESSAGE_MAX_CHARS=25000
HAF_HONCHO_TIMEOUT_MS=8000
HAF_HONCHO_MAX_RETRIES=0
HAF_HONCHO_ALLOW_SELF_HOSTED=false
HAF_HONCHO_ALLOW_PRIVATE_BASE_URL=false

# Optional model-planned refinement review cadence. 0 disables automatic review.
# Reviews create governed candidates only and never self-promote.
HAF_AUTO_REFINE_EVERY_TURNS=0

# HTTPS repository bootstrap limits
HAF_REPOSITORY_MAX_FILES=100000
HAF_REPOSITORY_MAX_BYTES=2147483648
HAF_REPOSITORY_TIMEOUT_MS=300000
# GitHub App private keys and webhook secrets are stored as Credential Broker
# secrets, then referenced through /v1/github-apps. Configure the GitHub App:
# setup callback: https://haf.example.com/auth/github-app/callback
# webhook:        https://haf.example.com/v1/platforms/github-app/webhook

# local is trusted-development only; docker/singularity/remote profiles provide stronger boundaries.
HAF_SANDBOX_BACKEND=local
# SSH sandbox settings (process execution + rsync workspace synchronization)
HAF_SSH_HOST=
HAF_SSH_USER=
HAF_SSH_PORT=22
HAF_SSH_IDENTITY_FILE=
HAF_SSH_REMOTE_ROOT=/tmp/haf-workspaces
HAF_SSH_SYNC_FILES=true

# Singularity/Apptainer sandbox settings. Local SIFs require SHA-256 by default;
# remote docker/oras/library URIs must end in @sha256:<digest>.
HAF_SINGULARITY_IMAGE=
HAF_SINGULARITY_EXECUTABLE=apptainer
HAF_SINGULARITY_IMAGE_SHA256=
HAF_SINGULARITY_ALLOW_UNPINNED=false
HAF_SINGULARITY_NETWORK=none

# Browser automation: connect to CDP or launch an installed Chromium executable.
HAF_BROWSER_CDP_ENDPOINT=
HAF_BROWSER_EXECUTABLE_PATH=
HAF_BROWSER_HEADLESS=true
HAF_BROWSER_ALLOW_PRIVATE_CDP=false

# OpenAI-compatible speech-to-text and text-to-speech provider
HAF_AUDIO_API_KEY=
HAF_AUDIO_BASE_URL=https://api.openai.com/v1
HAF_STT_MODEL=whisper-1
HAF_TTS_MODEL=gpt-4o-mini-tts
HAF_TTS_VOICE=alloy

# OpenAI-compatible image generation. Artifacts are materialized inside the workspace.
HAF_IMAGE_API_KEY=
HAF_IMAGE_BASE_URL=https://api.openai.com/v1
HAF_IMAGE_MODEL=gpt-image-1
HAF_IMAGE_QUALITY=auto
HAF_IMAGE_MAX_BYTES=20971520
# URL output retrieval is disabled by default; prefer base64-returning providers.
HAF_IMAGE_ALLOW_REMOTE_URLS=false
# Optional FAL image generation/editing with up to 8 references.
HAF_FAL_IMAGE_API_KEY=
HAF_FAL_IMAGE_MODEL=
HAF_FAL_IMAGE_EDIT_MODEL=
HAF_FAL_IMAGE_BASE_URL=https://fal.run
# Optional FAL 2x/4x upscaler; output dimensions are verified before materialization.
HAF_IMAGE_UPSCALE_API_KEY=
HAF_IMAGE_UPSCALE_MODEL=
HAF_IMAGE_UPSCALE_BASE_URL=https://fal.run

# FAL text-to-video / image-to-video (up to 4 reference images)
HAF_VIDEO_API_KEY=
HAF_VIDEO_MODEL=
HAF_VIDEO_BASE_URL=https://fal.run
HAF_VIDEO_MAX_BYTES=104857600
HAF_VIDEO_ALLOW_REMOTE_URLS=false
# Optional verified FAL MP4/WebM 2x/4x upscaler.
HAF_VIDEO_UPSCALE_API_KEY=
HAF_VIDEO_UPSCALE_MODEL=
HAF_VIDEO_UPSCALE_BASE_URL=https://fal.run
# Optional restart-persistent FAL queue jobs.
HAF_VIDEO_QUEUE_API_KEY=
HAF_VIDEO_QUEUE_MODEL=
HAF_VIDEO_QUEUE_BASE_URL=https://queue.fal.run

# Normalized public web search (brave | tavily)
HAF_WEB_SEARCH_PROVIDER=brave
HAF_WEB_SEARCH_API_KEY=
# Leave blank for provider default.
HAF_WEB_SEARCH_BASE_URL=
HAF_WEB_SEARCH_DEPTH=basic
HAF_WEB_SEARCH_COUNTRY=
HAF_WEB_SEARCH_LANGUAGE=

# OTLP/HTTP JSON metrics exporter
HAF_OTLP_ENDPOINT=
HAF_OTLP_HEADERS_JSON=
HAF_OTLP_INTERVAL_MS=60000

# Optional organization policy service. Any timeout/unavailability fails closed.
HAF_OPA_ENDPOINT=
HAF_OPA_BEARER_TOKEN=
HAF_OPA_TIMEOUT_MS=3000

# Distributed persistence and transport (leave unset for the local file profile)
HAF_POSTGRES_URL=
HAF_POSTGRES_SCHEMA=haf
HAF_POSTGRES_NOTIFY=true
HAF_POSTGRES_RLS=false
HAF_NATS_SERVERS=
HAF_NATS_TOKEN=
HAF_NATS_USER=
HAF_NATS_PASS=
HAF_NATS_PREFIX=haf

# Optional semantic embeddings; deterministic local hash vectors are the default.
HAF_EMBEDDING_API_KEY=
HAF_EMBEDDING_BASE_URL=https://api.openai.com/v1
HAF_EMBEDDING_MODEL=text-embedding-3-small
HAF_EMBEDDING_DIMENSIONS=1536

# Provider profiles: mock | openai | anthropic | openrouter | google | groq | xai | deepseek | mistral | ollama | openai-compatible
# For profile mode set HAF_MODEL_PROVIDER to the profile id and configure its standard key env var.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AWS_REGION=us-east-1
AWS_PROFILE=
# Or use the standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN chain.
GOOGLE_VERTEX_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# 32-byte base64/hex key or passphrase for restart-stable AES-GCM local secret storage.
# In production use Vault/KMS instead of a static environment value.
HAF_MASTER_KEY=

# Native outbound channel adapters
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_TENANT_ID=local
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MATRIX_HOMESERVER=
MATRIX_ACCESS_TOKEN=
SIGNAL_REST_URL=
SIGNAL_SENDER_NUMBER=
SIGNAL_REST_TOKEN=
MATTERMOST_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_ALLOW_LOOPBACK_HTTP=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_API_BASE=https://api.line.me
GOOGLE_CHAT_ACCESS_TOKEN=
GOOGLE_CHAT_API_BASE=https://chat.googleapis.com
TEAMS_ACCESS_TOKEN=
TEAMS_GRAPH_BASE=https://graph.microsoft.com
FEISHU_TENANT_ACCESS_TOKEN=
FEISHU_API_BASE=https://open.feishu.cn

# Long-lived IRC/IRCv3 transport. TLS and public DNS are mandatory by default.
IRC_HOST=
IRC_PORT=6697
IRC_TLS=true
IRC_TLS_CA_PATH=
IRC_ALLOW_PLAINTEXT=false
IRC_ALLOW_PRIVATE_HOST=false
IRC_NICKNAME=
IRC_USERNAME=
IRC_REAL_NAME=Hybrid Agent Fabric
IRC_CHANNELS=
IRC_ALLOWED_NICKNAMES=
IRC_ALLOWED_ACCOUNTS=
IRC_SERVER_PASSWORD=
IRC_SASL_ACCOUNT=
IRC_SASL_PASSWORD=
IRC_TENANT_ID=local
IRC_RECONNECT_MIN_MS=1000
IRC_RECONNECT_MAX_MS=60000
IRC_OUTBOUND_INTERVAL_MS=800

# TLS-first SMTP outbound and optional persistent IMAP inbound email channel.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS_CA_PATH=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Hybrid Agent Fabric
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_TLS_CA_PATH=
EMAIL_IMAP_MAILBOX=INBOX
# Required shared header value: X-HAF-Email-Token
EMAIL_INBOUND_TOKEN=
EMAIL_ALLOWED_SENDERS=
EMAIL_INBOUND_RECIPIENTS=
EMAIL_INITIAL_SYNC=latest
EMAIL_AUTO_REPLY=true
EMAIL_TENANT_ID=local
EMAIL_ALLOW_PRIVATE_HOST=false
EMAIL_POLL_INTERVAL_MS=30000
EMAIL_RECONNECT_MIN_MS=1000
EMAIL_RECONNECT_MAX_MS=60000
EMAIL_CONNECT_TIMEOUT_MS=15000
EMAIL_MAX_MESSAGE_BYTES=2097152
EMAIL_MAX_BODY_CHARS=20000
EMAIL_MAX_MESSAGES_PER_POLL=50

# Native bidirectional Twilio SMS. The webhook URL must exactly match the
# public HTTPS URL configured in Twilio so X-Twilio-Signature can be verified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALLOWED_NUMBERS=
TWILIO_WEBHOOK_URL=https://haf.example.com/v1/platforms/twilio/webhook
TWILIO_API_BASE=https://api.twilio.com
TWILIO_TENANT_ID=local

HAF_OUTBOUND_WEBHOOK_URL=
HAF_OUTBOUND_WEBHOOK_SECRET=

# Web identity and session security
HAF_AUTH_DISABLED=false
HAF_SESSION_SECRET=
HAF_SESSION_TTL_MS=28800000
HAF_SESSION_COOKIE_NAME=haf_session
HAF_COOKIE_SECURE=true
HAF_DEFAULT_TENANT=local

# Dedicated remote TUI/headless client (client process environment)
HAF_URL=http://127.0.0.1:8787
HAF_TENANT=local
HAF_CLIENT_TIMEOUT_MS=30000
# HAF_API_TOKEN above is reused by the client; never pass it as a CLI argument.

# OIDC Authorization Code + PKCE
HAF_OIDC_ISSUER=
HAF_OIDC_CLIENT_ID=
HAF_OIDC_CLIENT_SECRET=
HAF_OIDC_REDIRECT_URI=
HAF_OIDC_SCOPES=openid profile email
HAF_OIDC_TENANT_CLAIM=haf_tenants
HAF_OIDC_ROLE_CLAIM=roles

# Native inbound platform verification and authorization
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_TENANT_ID=local
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_TENANT_ID=local
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_PHONE_NUMBERS=
WHATSAPP_TENANT_ID=local
SIGNAL_WEBHOOK_SECRET=
SIGNAL_ALLOWED_NUMBERS=
SIGNAL_TENANT_ID=local
MATRIX_WEBHOOK_SECRET=
MATRIX_ALLOWED_USER_IDS=
MATRIX_ALLOWED_ROOM_IDS=
MATRIX_TENANT_ID=local
MATTERMOST_WEBHOOK_TOKEN=
MATTERMOST_ALLOWED_USER_IDS=
MATTERMOST_ALLOWED_CHANNEL_IDS=
MATTERMOST_TENANT_ID=local
LINE_CHANNEL_SECRET=
LINE_ALLOWED_USER_IDS=
LINE_ALLOWED_CHAT_IDS=
LINE_TENANT_ID=local
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_CHAT_ALLOWED_USER_IDS=
GOOGLE_CHAT_ALLOWED_SPACE_IDS=
GOOGLE_CHAT_TENANT_ID=local
TEAMS_APP_ID=
TEAMS_JWT_ISSUER=https://api.botframework.com
TEAMS_JWKS_URL=
TEAMS_ALLOWED_USER_IDS=
TEAMS_ALLOWED_CONVERSATION_IDS=
TEAMS_TENANT_ID=local
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_USER_IDS=
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_TENANT_ID=local

# HashiCorp Vault KV v2 credential backend (takes precedence over local AES file)
HAF_VAULT_ADDRESS=
HAF_VAULT_TOKEN=
HAF_VAULT_NAMESPACE=
HAF_VAULT_MOUNT=secret
HAF_VAULT_PREFIX=haf

# Modal/Daytona/Vercel/Kubernetes sandbox gateway contract
HAF_CLOUD_SANDBOX_GATEWAY=
HAF_CLOUD_SANDBOX_TOKEN=
HAF_CLOUD_SANDBOX_TEMPLATE=
HAF_CLOUD_SANDBOX_NETWORK_POLICY=none
HAF_CLOUD_SANDBOX_ALLOWED_HOSTS=

# Signed WASI plugins and learning releases (JSON map: key-id -> Ed25519 public key)
HAF_WASI_TRUSTED_KEYS_JSON=
HAF_WASI_RUNNER_PATH=
HAF_WASI_TIMEOUT_MS=5000
HAF_WASI_MAX_OUTPUT_BYTES=1048576
HAF_LEARNING_TRUSTED_KEYS_JSON=

# Hosted scale-to-zero scheduler relay
HAF_HOSTED_SCHEDULER_PORTAL_URL=
HAF_HOSTED_SCHEDULER_ACCESS_TOKEN=
HAF_HOSTED_SCHEDULER_CALLBACK_URL=
HAF_HOSTED_SCHEDULER_AUDIENCE=
HAF_HOSTED_SCHEDULER_ISSUER=
HAF_HOSTED_SCHEDULER_JWKS_URL=
