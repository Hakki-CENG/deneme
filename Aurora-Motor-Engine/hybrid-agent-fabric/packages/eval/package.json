{
  "name": "@haf/eval",
  "version": "1.65.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx src/runner/cli.ts",
    "eval:validate": "tsx src/runner/validate-criteria-cli.ts",
    "eval:baseline": "tsx src/runner/live-baseline-cli.ts",
    "eval:recall": "tsx src/runner/recall-gate-cli.ts",
    "eval:recall:lock": "tsx src/runner/recall-gate-cli.ts --regression-lock",
    "eval:learning": "tsx src/runner/learning-gate-cli.ts",
    "docs:state": "tsx src/runner/state-docs-cli.ts",
    "eval:recall:real": "bash tools/run-real-recall.sh"
  },
  "dependencies": {
    "@haf/engine": "1.65.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "vitest": "^3.2.1"
  }
}
